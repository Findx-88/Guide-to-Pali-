    { "from": "voc", "to": "nom", "label": "same plural -ā" },
    { "from": "neuter", "to": "acc", "label": "-aṃ / -āni" },
    { "from": "ti", "to": "o-v", "label": "ends the sentence" },
    { "from": "i-end", "to": "cases", "label": "is what cases are" }
  ]
}
