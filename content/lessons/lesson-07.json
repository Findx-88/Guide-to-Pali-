  "revision": {
    "title": "Quick Revision — Lesson VI (Genitive)",
    "summaryHtml": "The Genitive (-ssa sg., -ānaṃ pl.) shows <strong>possession</strong>: \"of the man,\" \"the farmer's son.\"",
    "connectionHtml": "<strong>Connection:</strong> The Genitive tells us who <em>owns</em> something. The Locative tells us <em>where</em> something is. \"The man's son sits <em>in the monastery</em>.\"",
    "questions": [
      {
        "q": "What is the Genitive singular ending?",
        "a": "<strong>-ssa</strong>"
      },
      {
        "q": "Which two cases share -ssa and -ānaṃ?",
        "a": "<strong>Dative</strong> and <strong>Genitive</strong>"
      }
    ]
  },
  "teach": [
    {
      "id": "grammar",
      "title": "The Locative CaseLocation",
      "blocks": [
        {
          "type": "heading",
          "level": 2,
          "eyebrow": "Grammar",
          "html": "The <em>Locative</em> Case<br>Location"
        },
        {
          "type": "prose",
          "html": "The Locative case indicates <strong>where</strong> something happens. It translates as <em>\"in,\" \"on,\" \"at,\"</em> or <em>\"upon.\"</em>"
        },
        {
          "type": "rule",
          "title": "For masculine nouns ending in -a:",
          "formulas": [
            "Singular: base + <em>-smiṃ</em> or <em>-e</em> <span>|</span> narasmiṃ / nare",
            "Plural:&nbsp;&nbsp;&nbsp;base + <em>-esu</em> <span>|</span> naresu"
          ]
        },
        {
          "type": "table",
          "caption": "Seven cases — almost complete!",
          "head": [
            "Case",
            "Function",
            "Singular",
            "Plural"
          ],
          "rows": [
            [
              "Nominative",
              "Subject",
              "<span class=\"decl-ending\">-o</span>",
              "<span class=\"decl-ending\">-ā</span>"
            ],
            [
              "Accusative",
              "Object",
              "<span class=\"decl-ending\">-ṃ</span>",
              "<span class=\"decl-ending\">-e</span>"
            ],
            [
              "Instrumental",
              "By/with",
              "<span class=\"decl-ending\">-ena</span>",
              "<span class=\"decl-ending\">-ehi</span>"
            ],
            [
              "Ablative",
              "From",
              "<span class=\"decl-ending\">-ā/-smā/-mhā</span>",
              "<span class=\"decl-ending\">-ehi</span>"
            ],
            [
              "Dative",
              "For/to",
              "<span class=\"decl-ending\">-āya/-ssa</span>",
              "<span class=\"decl-ending\">-ānaṃ</span>"
            ],
            [
              "Genitive",
              "Of",
              "<span class=\"decl-ending\">-ssa</span>",
              "<span class=\"decl-ending\">-ānaṃ</span>"
            ],
            [
              "Locative",
              "In/on/at",
              "<span class=\"decl-ending\">-smiṃ / -e</span>",
              "<span class=\"decl-ending\">-esu</span>"
            ]
          ]
        }
      ]
    }
